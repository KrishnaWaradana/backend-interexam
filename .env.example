# Port Server (Otomatis disediakan oleh platform seperti Railway / Render)
PORT=5000

# Database URL PostgreSQL (Contoh dari Supabase, Neon, Railway Postgres, dll)
DATABASE_URL="postgresql://username:password@host:5432/interexam?sslmode=require"

# URL Frontend Production di Vercel (untuk konfigurasi CORS)
FRONTEND_URL="https://your-frontend-app.vercel.app"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Midtrans Server & Client Key
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxx"

# Nodemailer / Email Service
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# JWT Config
JWT_SECRET="ganti_dengan_string_rahasia_acak_minimal_32_karakter"
JWT_EXPIRES_IN="1d"
